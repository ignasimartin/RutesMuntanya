<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botó carregar GPX (dalt esquerra) -->
    <ImageButton
        android:id="@+id/btnLoad"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_margin="14dp"
        android:padding="14dp"
        android:background="@drawable/bg_fab"
        android:elevation="6dp"
        android:src="@drawable/ic_folder"
        android:scaleType="fitCenter"
        android:contentDescription="Carrega GPX"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Píndola amb el nom de la ruta -->
    <LinearLayout
        android:id="@+id/cardRouteName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill"
        android:elevation="6dp"
        android:padding="10dp"
        android:layout_marginEnd="14dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@+id/btnLoad"
        app:layout_constraintBottom_toBottomOf="@+id/btnLoad"
        app:layout_constraintStart_toEndOf="@+id/btnLoad"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_pin"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txtRouteName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Rètol de gir (mode seguiment) -->
    <LinearLayout
        android:id="@+id/navBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_banner_green"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgTurn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="14dp"
            android:padding="11dp"
            android:background="@drawable/bg_turnicon"
            android:src="@drawable/ic_nav_straight"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:textColor="@color/white"
                android:textSize="36sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:text="" />

            <TextView
                android:id="@+id/txtManeuver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <!-- Columna de botons flotants (dreta) -->
    <LinearLayout
        android:id="@+id/fabColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomCard"
        android:layout_marginBottom="14dp">

        <ImageButton
            android:id="@+id/btnLayer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:padding="12dp"
            android:background="@drawable/bg_fab"
            android:elevation="6dp"
            android:src="@drawable/ic_layers"
            android:scaleType="fitCenter"
            android:contentDescription="Capes" />

        <ImageButton
            android:id="@+id/btnDownload"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:padding="12dp"
            android:background="@drawable/bg_fab"
            android:elevation="6dp"
            android:src="@drawable/ic_download"
            android:scaleType="fitCenter"
            android:contentDescription="Baixa mapes" />

        <ImageButton
            android:id="@+id/btnCenter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="@drawable/bg_fab"
            android:elevation="6dp"
            android:src="@drawable/ic_center"
            android:scaleType="fitCenter"
            android:contentDescription="Centra'm" />
    </LinearLayout>

    <!-- Perfil d'altitud -->
    <com.exemple.rutesmuntanya.ElevationProfileView
        android:id="@+id/elevationProfile"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:background="#CC000000"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/bottomCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Full inferior (estadístiques + acció) -->
    <LinearLayout
        android:id="@+id/bottomCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottomcard"
        android:elevation="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@color/line" />

        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <LinearLayout style="@style/StatTile">
                <TextView android:id="@+id/txtStatDist" style="@style/StatValue" android:text="—" />
                <TextView style="@style/StatLabel" android:text="Distància" />
            </LinearLayout>

            <LinearLayout style="@style/StatTile">
                <TextView android:id="@+id/txtStatUp" style="@style/StatValue" android:textColor="@color/green" android:text="—" />
                <TextView style="@style/StatLabel" android:text="Pujada" />
            </LinearLayout>

            <LinearLayout style="@style/StatTile">
                <TextView android:id="@+id/txtStatDown" style="@style/StatValue" android:textColor="@color/coral" android:text="—" />
                <TextView style="@style/StatLabel" android:text="Baixada" />
            </LinearLayout>

            <LinearLayout style="@style/StatTile">
                <TextView android:id="@+id/txtStatTop" style="@style/StatValue" android:text="—" />
                <TextView style="@style/StatLabel" android:text="Cim" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnProfile"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:textSize="14sp"
                android:text="@string/btn_profile" />

            <Button
                android:id="@+id/btnNavigate"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cta"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="6dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/btn_navigate" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
